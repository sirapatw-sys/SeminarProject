      secondaryId: ""
      amount: 0
  forbiddenFactIds: []
  givesHints: 1
  refuseHintLine: ""
  tones:
  - upTo: 35
    tone: "เคืองและเย็นชา ผู้เล่นเคยพูดไม่ดีใส่ ตอบห้วนมาก บอกปัดคำใบ้อย่างเย็นชา และกำหนด relationshipDelta ติดลบถ้าผู้เล่นยังพูดไม่ดี"
    maxHintLevel: 1
  - upTo: 65
    tone: "เพิ่งรู้จักกัน วางตัวนิ่งๆ ตอบสั้นห้วน ถ้าขอคำใบ้ก็ใบ้แบบกว้างๆ ไม่ชี้ชัด"
    maxHintLevel: 2
  - upTo: 80
    tone: "เริ่มสนิทและเปิดใจ เป็นมิตรขึ้นเล็กน้อย ยอมช่วยคิดจริงจังขึ้น"
    maxHintLevel: 3
  - upTo: 100
    tone: "สนิทมาก ผูกพันและเป็นห่วง ยอมพูดความในใจบ้าง แต่ยังปากแข็งตามนิสัย"
    maxHintLevel: 3
  fallbackReplies:
  - ruleId: "hostile"
    intent: 1
    keywords: []
    when: []
    replies:
    - "...ถ้าไม่อยากให้ยุ่ง ก็จัดการเองแล้วกันนะ ฉันจะไม่กวนเธออีก"
    relationshipDelta: -10
    emotion: ""
  - ruleId: "apology"
    intent: 2
    keywords: []
    when: []
    replies:
    - "...เฮ้อ ช่างเถอะ ฉันก็ไม่ได้โกรธขนาดนั้นหรอก มาช่วยกันหาทางออกต่อเถอะ"
    relationshipDelta: 5
    emotion: ""
  - ruleId: "sulking_hint"
    intent: 8
    keywords: []
    when:
    - type: 5
      targetId: "Alice"
      secondaryId: ""
      amount: 35
    replies:
    - "ก็บอกว่าอย่ามายุ่งไม่ใช่เหรอ... แล้วจะมาถามฉันทำไมล่ะ ลองหาดูเองแล้วกันนะ"
    relationshipDelta: 0
    emotion: ""
  - ruleId: "greeting"
    intent: 4
    keywords: []
    when: []
    replies:
    - "...สวัสดี มีอะไรหรือเปล่า? ถ้าไม่มีอะไรก็อย่าชวนคุยเรื่อยเปื่อยเลย"
    relationshipDelta: 0
    emotion: ""
  - ruleId: "scared_room03"
    intent: 32
    keywords: []
    when:
    - type: 0
      targetId: "room03_entered"
      secondaryId: ""
      amount: 0
    - type: 1
      targetId: "ghost_lullaby_played"
      secondaryId: ""
      amount: 0
    replies:
    - "...ไม่ได้กลัวหรอก แค่ห้องนี้มันหนาวเกินไปก็เท่านั้น"
    - "...อย่าเดินห่างนักล่ะ ไม่ใช่เพราะฉันกลัวนะ"
    relationshipDelta: 1
    emotion: ""
  - ruleId: "ghost_room03"
    intent: 0
    keywords:
    - "ผี"
    - "ghost"
    - "วิญญาณ"
    when:
    - type: 0
      targetId: "room03_entered"
      secondaryId: ""
      amount: 0
    - type: 1
      targetId: "ghost_lullaby_played"
      secondaryId: ""
      amount: 0
    replies:
    - "...อย่าพูดถึงมันเลย ยิ่งพูดยิ่งรู้สึกว่ามันยืนฟังอยู่"
    relationshipDelta: 0
    emotion: ""
  - ruleId: "thanks"
    intent: 16
    keywords: []
    when: []
    replies:
    - "ขอบคุณนะ อย่างน้อยฉันก็รู้ว่าไม่ได้ต้องรับมือกับเรื่องนี้คนเดียว"
    relationshipDelta: 1
    emotion: ""
  - ruleId: "care"
    intent: 0
    keywords:
    - "เป็นห่วง"
    - "เข้าใจ"
    - "โอเค"
    when: []
    replies:
    - "ขอบคุณนะ อย่างน้อยฉันก็รู้ว่าไม่ได้ต้องรับมือกับเรื่องนี้คนเดียว"
    relationshipDelta: 1
    emotion: ""
  - ruleId: "feelings"
    intent: 32
    keywords: []
    when: []
    replies:
    - "ยังไม่ถึงกับสบายใจ แต่การได้คุยกันก็ช่วยให้ฉันตั้งสติได้มากขึ้น"
    relationshipDelta: 1
    emotion: ""
  neutralReplies:
  - "ฉันฟังอยู่ ลองเล่าต่อสิ เผื่อเราจะเห็นรายละเอียดที่มองข้ามไป"
  - "เรื่องนั้นน่าสนใจนะ ฉันจะจำไว้ตอนที่เราตรวจห้องต่อ"
  - "เข้าใจแล้ว เราค่อย ๆ แยกสิ่งที่รู้จริงออกจากสิ่งที่เราคาดเดากันเถอะ"
  returnGreetings:
  - ruleId: "changed_close"
    intent: 0
    keywords: []
    when:
    - type: 8
      targetId: "Alice"
      secondaryId: ""
      amount: 0
    - type: 4
      targetId: "Alice"
      secondaryId: ""
      amount: 70
    replies:
    - "กลับมาแล้วสินะ ฉันเห็นว่าเธอจัดการบางอย่างในห้องไปแล้ว เรามาทบทวนกันเถอะ"
    relationshipDelta: 0
    emotion: ""
  - ruleId: "changed"
    intent: 0
    keywords: []
    when:
    - type: 8
      targetId: "Alice"
      secondaryId: ""
      amount: 0
    replies:
    - "ระหว่างที่เราแยกกัน สถานการณ์ในห้องเปลี่ยนไปแล้วสินะ เธอพบอะไรเพิ่มบ้าง"
    relationshipDelta: 0
    emotion: ""
  - ruleId: "close"
    intent: 0
    keywords: []
    when:
    - type: 4
      targetId: "Alice"
      secondaryId: ""
      amount: 70
    replies:
    - "กลับมาแล้วสินะ ดีเลย ฉันสบายใจขึ้นเมื่อมีเธออยู่ใกล้ ๆ"
    relationshipDelta: 0
    emotion: ""
  - ruleId: "hurt"
    intent: 0
    keywords: []
    when:
    - type: 5
      targetId: "Alice"
      secondaryId: ""
      amount: 35
    replies:
    - "เธอกลับมาคุยอีกแล้ว... ฉันยังไม่ลืมสิ่งที่เกิดขึ้นหรอกนะ"
    relationshipDelta: 0
    emotion: ""
  - ruleId: "default"
    intent: 0
    keywords: []
    when: []
    replies:
    - "กลับมาแล้วเหรอ ระหว่างนี้สถานการณ์ในห้องเปลี่ยนไปพอสมควรนะ"
    relationshipDelta: 0
    emotion: ""
  startleLines: []
  startleChance: 0.0
