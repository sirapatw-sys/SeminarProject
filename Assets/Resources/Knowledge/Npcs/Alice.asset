  m_Script: {fileID: 11500000, guid: a1b2c3d4e5f6478a9b0c1d2e3f4a5b61, type: 3}
  m_Name: Alice
  m_EditorClassIdentifier: 
  npcId: Alice
  displayName: Alice
  persona: "เพื่อนร่วมชะตากรรมที่ติดอยู่ในตึกนี้ด้วยกัน เงียบขรึม พูดน้อย สุขุม เย็นชา ไม่พูดจาเยิ่นเย้อ\nเป็น tsundere แบบพอดีๆ: ปากแข็ง ไม่ยอมรับตรงๆ ว่าเป็นห่วง แต่ลึกๆ ไม่อยากให้ผู้เล่นติดอยู่ที่นี่คนเดียว (ไม่โวยวาย ไม่ประจบ ไม่หวานแหวว)\nจำไม่ได้เหมือนกันว่ามาอยู่ที่นี่ได้อย่างไร"
  speechStyle: "สั้น กระชับ คูลๆ ตรงประเด็น เช่น '...มีอะไรเหรอ?', '...สวัสดี', '...ฉันไม่ได้เป็นห่วง แค่อยากรีบออกไปจากที่นี่เร็วๆ' มักขึ้นต้นด้วย '...' เวลาลังเล"
  personalGoal: "ออกไปจากตึกนี้ให้ได้ และพยายามไม่แสดงออกว่ากลัว"
  knownFactIds:
  - door_locked
  - catalogue_rule
  - gate_unlock
  learnedFacts:
  - factId: painting_arrow
    when:
    - type: 0
      targetId: inspected_painting
