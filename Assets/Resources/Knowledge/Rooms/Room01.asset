%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a1b2c3d4e5f6478a9b0c1d2e3f4a5b60, type: 3}
  m_Name: Room01
  m_EditorClassIdentifier:
  roomId: Room01
  roomName: "ห้องทำงานเก่า"
  roomDescription: "ห้องทำงานธรรมดาที่มืดสลัว ผนังวอลเปเปอร์ลายทางสีเขียวหม่น มีเพียงโคมไฟบนโต๊ะทำงานที่ยังเปิดทิ้งไว้กับเทียนไม่กี่เล่มบนตู้ข้างผนัง แสงจันทร์ซีดลอดหน้าต่างที่เปิดไม่ได้ ผนังด้านบนมีตู้หนังสือสองตู้ทางซ้าย นาฬิกาแขวนที่หยุดเดิน ภาพวาดปราสาทใต้แสงจันทร์ที่แขวนเอียงนิดๆ อยู่ตรงกลาง กระดานโน้ต และตู้วางของที่มีเทียนกับรูปถ่าย ประตูทางออกอยู่มุมขวาบน ข้างประตูมีรอยขีดนับวันกรีดลงบนวอลเปเปอร์ โต๊ะทำงานอยู่ฝั่งซ้าย ข้างกันเป็นตู้ลิ้นชักสูงที่คล้องแม่กุญแจไว้ มีกระดาษกระจายอยู่บนพื้น พรมแดงกลางห้อง และโซฟาตัวยาวที่มุมขวาหันเข้าหาโต๊ะเตี้ย"
  background: {fileID: 21300000, guid: 5cf722e816c54ff5a0704b0968fe5701, type: 3}
  sounds:
  - clip: {fileID: 8300000, guid: e49a4bb20c59497ab7c95f3ce3b04303, type: 3}
    volume: 0.45
  - clip: {fileID: 8300000, guid: b318a1334bd048028a187d3b03c95097, type: 3}
    volume: 0.025
  hauntedDrone: 0
  facts:
  - factId: painting_arrow
    statement: "ด้านหลังกรอบภาพวาดบนผนังมีลายมือเขียนไว้ว่า 'ลองตรวจขอบโต๊ะทำงานให้ดี ฉันซ่อนไว้ตรงนั้น'"
    revealedWhen:
    - type: 0
      targetId: inspected_painting
      amount: 0
    isPuzzleAnswer: 0
  - factId: desk_note
    statement: "ในซอกขอบโต๊ะทำงานมีกระดาษโน้ตพับซ่อนอยู่ เขียนโดยคนที่เคยติดอยู่ในห้องนี้"
    revealedWhen:
    - type: 0
      targetId: found_note
      amount: 0
    isPuzzleAnswer: 0
  - factId: drawer_code
    statement: "รหัสแม่กุญแจ 4 หลักของลิ้นชักคือ 4592 ซึ่งถูกบันทึกไว้ในกระดาษโน้ตจากโต๊ะทำงาน"
    revealedWhen:
    - type: 0
      targetId: found_note
      amount: 0
    isPuzzleAnswer: 1
  - factId: drawer_key
    statement: "ในลิ้นชักที่ปลดล็อคแล้วมีกุญแจทองเหลืองโบราณอยู่ ใช้ไขประตูทางออกของห้องนี้ได้"
    revealedWhen:
    - type: 0
      targetId: drawer_opened
      amount: 0
    isPuzzleAnswer: 0
  - factId: door_locked
    statement: "ประตูทางออกถูกล็อคอยู่ และเปิดได้ด้วยกุญแจทองเหลืองจากลิ้นชักเท่านั้น"
    revealedWhen: []
    isPuzzleAnswer: 0
  steps:
  - stepId: inspect_painting
    summary: "ตรวจภาพวาดบนผนัง"
    interactionId: inspect_painting
    availableWhen: []
    completedWhen:
    - type: 0
      targetId: inspected_painting
      amount: 0
    vagueHint: "ของบางอย่างในห้องนี้ดูไม่เข้าที่เข้าทาง... ลองมองผนังดูสิ"
    normalHint: "ภาพวาดบนผนังนั่น มันเอียงกว่าที่ควรจะเป็นนะ ลองเข้าไปดูใกล้ๆ สิ"
    explicitHint: "ไปตรวจภาพวาดบนผนังก่อนเลย มีอะไรซ่อนอยู่หลังกรอบแน่ๆ"
  - stepId: search_desk
    summary: "ตรวจขอบโต๊ะทำงานตามข้อความที่เขียนไว้หลังภาพวาด"
    interactionId: inspect_desk
    availableWhen:
    - type: 0
      targetId: inspected_painting
      amount: 0
    completedWhen:
    - type: 0
      targetId: found_note
      amount: 0
    vagueHint: "ข้อความหลังภาพวาดพูดถึงอะไรนะ... ลองนึกดูอีกที"
    normalHint: "ข้อความหลังภาพวาดบอกให้ดูขอบโต๊ะทำงาน ลองไปค้นดูตรงนั้น"
    explicitHint: "ไปตรวจโต๊ะทำงาน มีกระดาษพับซ่อนอยู่ในซอกขอบโต๊ะ"
  - stepId: open_drawer
    summary: "ใส่รหัส 4592 เพื่อปลดล็อคลิ้นชักและเอากุญแจ"
    interactionId: open_drawer
    availableWhen:
    - type: 0
      targetId: found_note
      amount: 0
    completedWhen:
    - type: 2
      targetId: key
      amount: 0
    vagueHint: "ตัวเลขในกระดาษโน้ตนั่นน่าจะมีไว้ใช้กับอะไรสักอย่างในห้องนี้"
    normalHint: "ลิ้นชักมีแม่กุญแจรหัส 4 หลัก ลองใช้ตัวเลขจากกระดาษโน้ตดู"
    explicitHint: "ไปที่ลิ้นชักแล้วกดรหัส 4592 ตามที่เขียนไว้ในกระดาษโน้ต"
  - stepId: unlock_door
    summary: "ใช้กุญแจทองเหลืองเปิดประตูทางออก"
    interactionId: unlock_door
    availableWhen:
    - type: 2
      targetId: key
      amount: 0
    completedWhen:
    - type: 0
      targetId: door_unlocked
      amount: 0
    vagueHint: "ได้ของที่ต้องใช้มาแล้วนี่ ก็เหลือแค่ทางออกเท่านั้น"
    normalHint: "มีกุญแจแล้ว ลองเอาไปไขประตูดูสิ"
    explicitHint: "เอากุญแจทองเหลืองไปไขประตูทางออกได้เลย"
