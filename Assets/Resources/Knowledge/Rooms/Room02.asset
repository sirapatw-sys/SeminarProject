%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: a1b2c3d4e5f6478a9b0c1d2e3f4a5b60, type: 3}
  m_Name: Room02
  m_EditorClassIdentifier:
  roomId: Room02
  enteredFlag: room02_entered
  roomName: "หอสมุดร้าง"
  roomDescription: "หอสมุดเพดานสูงที่มืดและเต็มไปด้วยฝุ่น ผนังซ้ายเป็นตู้หนังสือสูงจรดเพดานแบ่งเป็นสามชั้นใหญ่ ฝั่งขวาเป็นโต๊ะอ่านหนังสือที่มีสมุดทะเบียนเปิดค้างไว้ ลูกโลกดาราศาสตร์ และเทียนไข ผนังขวาบนมีแผงเฟืองนาฬิกาฝังอยู่ มีนาฬิกาโบราณอยู่ข้างประตูดวงดาวที่เรืองแสงจางๆ ตรงกลางผนังด้านบน และมีแท่นไฟศักดิ์สิทธิ์ขนาบประตูทั้งสองข้าง"
  background: {fileID: 21300000, guid: 9fe0cfe4f0824aa09de92b68db92f926, type: 3}
  sounds:
  - clip: {fileID: 8300000, guid: ed06d9a9ca6643e492ea1f25478496dc, type: 3}
    volume: 0.45
  - clip: {fileID: 8300000, guid: 214c674a3342408eacc4e6710fbbbfc1, type: 3}
    volume: 0.16
  - clip: {fileID: 8300000, guid: b318a1334bd048028a187d3b03c95097, type: 3}
    volume: 0.025
  hauntedDrone: 0
  gameplayTerms:
  - "ตู้หนังสือ"
  - "ชั้นหนังสือ"
  - "สมุดทะเบียน"
  - "จารึก"
  - "แท่นไฟ"
  - "แผงเฟือง"
  - "ledger"
  - "catalogue"
  - "catalog"
  - "bookshelf"
  - "bookcase"
  - "tome"
  - "offering"
  - "altar"
  - "brazier"
  - "clockwork"
  - "gate"
  facts:
  - factId: clock_inscription
    statement: "แผ่นทองเหลืองใต้หน้าปัดนาฬิกาโบราณสลักว่า 'เมื่อเข็มข้ามเที่ยงคืนไป สิ่งที่เจ้าเฝ้ารอทั้งคืนจะเปลี่ยนชื่อของมันทันที'"
    revealedWhen:
    - type: 0
      targetId: inspected_clock
      amount: 0
    isPuzzleAnswer: 0
  - factId: shelf_poem
    statement: "บนตู้หนังสือชั้นกลางมีบทกวีว่า 'ข้าวิ่งนำหน้าเจ้าเสมอ แต่ไม่เคยไปถึงไหน เจ้าใช้ทั้งชีวิตรอคอยข้า แต่วินาทีที่ข้ามาถึง ข้าก็ถูกเรียกด้วยชื่ออื่นไปแล้ว' และมีลายมือเขียนแทรกว่า 'มันไม่ใช่สิ่งของ มันคือช่วงเวลา'"
    revealedWhen:
    - type: 0
      targetId: inspected_bookshelf_r2
      amount: 0
    isPuzzleAnswer: 0
  - factId: brazier_stele
    statement: "ศิลาจารึกที่ฐานแท่นไฟบอกว่าผู้เฝ้าประตูจะเรียกของถวายก่อน แล้วจึงตั้งคำถามถึงช่วงเวลาที่ไม่มีวันมาถึง และนางไม่เคยให้คำใบ้แก่ผู้ใด"
    revealedWhen:
    - type: 0
      targetId: inspected_altar
      amount: 0
    isPuzzleAnswer: 0
  - factId: clockwork_wall
    statement: "แผงเฟืองบนผนังขวาบนหยุดนิ่งเกือบหมด เหลือเฟืองเล็กสุดที่ยังขยับ ใต้แผงสลักว่า 'กลไกนี้นับสิ่งที่ยังมาไม่ถึง มิใช่สิ่งที่ผ่านพ้นไปแล้ว'"
    revealedWhen:
    - type: 0
      targetId: inspected_clockwork
      amount: 0
    isPuzzleAnswer: 0
  - factId: catalogue_rule
    statement: "ป้ายทองเหลืองบนตู้หนังสือระบุว่าหนังสือทุกเล่มในหอนี้ถูกลงทะเบียนไว้ ผู้ใดหาเล่มใดไม่พบ ต้องไปค้นจากสมุดทะเบียนบนโต๊ะอ่านหนังสือ"
    revealedWhen: []
    isPuzzleAnswer: 0
    isPuzzleGuidance: 1
  - factId: tome_shelf_number
    statement: "สมุดทะเบียนระบุว่า 'จารึกที่ยังเขียนมิจบ' คือเล่มที่ ๙๙๙ เก็บไว้ที่ตู้ทิศตะวันตก ชั้นล่างสุด ซึ่งก็คือตู้หนังสือใหญ่ฝั่งซ้ายของหอ"
    revealedWhen:
    - type: 0
      targetId: read_ledger
      amount: 0
    isPuzzleAnswer: 0
  - factId: sena_demand
    statement: "เซนะ นางฟ้าผู้เฝ้าประตู จะไม่เอ่ยปริศนาแก่ผู้ที่มามือเปล่า นางเรียก 'จารึกที่ยังเขียนมิจบ' เป็นของถวายก่อน"
    revealedWhen:
    - type: 0
      targetId: sena_wants_tome
      amount: 0
    isPuzzleAnswer: 0
  - factId: riddle_answer
    statement: "คำตอบของปริศนาเซนะคือ 'พรุ่งนี้' (Tomorrow)"
    revealedWhen:
    - type: 0
      targetId: sena_offering_given
      amount: 0
    isPuzzleAnswer: 1
    protectedTerms:
    - "พรุ่งนี้"
    - "วันพรุ่งนี้"
    - "วันถัดไป"
    - "วันต่อไป"
    - "วันรุ่งขึ้น"
    - "อนาคต"
    - "tomorrow"
    - "next day"
    - "the next day"
    - "future"
    - "the future"
    - "tmr"
  - factId: gate_unlock
    statement: "ประตูดวงดาวจะเปิดก็ต่อเมื่อเซนะยอมรับคำตอบและจางหายไปแล้วเท่านั้น"
    revealedWhen: []
    isPuzzleAnswer: 0
    isPuzzleGuidance: 1
  steps:
  - stepId: meet_sena
    summary: "คุยกับเซนะที่ขวางประตูอยู่ เพื่อฟังว่านางต้องการอะไร"
    interactionId: 
    availableWhen: []
    completedWhen:
    - type: 0
      targetId: sena_wants_tome
      amount: 0
    vagueHint: "ที่หน้าประตูนั่นเหมือนมีใครยืนอยู่นะ"
    normalHint: "คนที่ยืนขวางประตูอยู่ คงต้องการอะไรจากเราสักอย่าง"
    explicitHint: "ลองไปคุยกับนางฟ้าที่หน้าประตูดูสิ"
  - stepId: read_ledger
    summary: "อ่านสมุดทะเบียนบนโต๊ะอ่านหนังสือฝั่งขวา เพื่อหาเลขชั้นของหนังสือ"
    interactionId: read_ledger
    availableWhen:
    - type: 0
      targetId: sena_wants_tome
      amount: 0
    completedWhen:
    - type: 0
      targetId: read_ledger
      amount: 0
    vagueHint: "หนังสือเป็นพันเล่มแบบนี้ ไล่หาทีละเล่มคงไม่ไหวหรอก"
    normalHint: "หอสมุดแบบนี้ ที่ไหนสักแห่งน่าจะมีบันทึกว่าหนังสือเล่มไหนอยู่ตรงไหน"
    explicitHint: "ลองไปดูแถวโต๊ะอ่านหนังสือสิ"
  - stepId: take_tome
    summary: "หยิบ 'จารึกที่ยังเขียนมิจบ' จากตู้หนังสือชั้นล่างสุดฝั่งซ้าย"
    interactionId: take_tome
    availableWhen:
    - type: 0
      targetId: read_ledger
      amount: 0
    completedWhen:
    - type: 0
      targetId: found_tome
      amount: 0
    vagueHint: "ทะเบียนบอกที่เก็บไว้แล้วนี่ ก็แค่ตามไป"
    normalHint: "ลองนึกดูว่าทะเบียนเขียนทิศไหนกับชั้นไหนไว้"
    explicitHint: "ลองไปดูแถวตู้หนังสือฝั่งซ้ายสิ"
  - stepId: give_offering
    summary: "นำจารึกไปมอบให้เซนะ เพื่อให้นางเอ่ยปริศนา"
    interactionId: 
    availableWhen:
    - type: 2
      targetId: tome
      amount: 0
    completedWhen:
    - type: 0
      targetId: sena_offering_given
      amount: 0
    vagueHint: "เหมือนเราจะได้สิ่งที่นางต้องการมาแล้วนะ"
    normalHint: "จารึกที่เพิ่งได้มา น่าจะเป็นของที่นางพูดถึง"
    explicitHint: "ลองเอาจารึกไปให้นางฟ้าที่หน้าประตูดูสิ"
  - stepId: answer_riddle
    summary: "พิมพ์คำตอบปริศนาในช่องแชทของเซนะ"
    interactionId: 
    availableWhen:
    - type: 0
      targetId: sena_offering_given
      amount: 0
    completedWhen:
    - type: 0
      targetId: sena_passed
      amount: 0
    vagueHint: "ลองคิดถึงสิ่งที่เรารอคอยอยู่ทุกวันดูสิ"
    normalHint: "มันไม่ใช่สิ่งของหรอก... เป็นเรื่องของเวลา"
    explicitHint: "เป็น 'วัน' ที่เรารอ แต่ไปไม่ถึงสักที เพราะพอข้ามเที่ยงคืน มันก็กลายเป็น 'วันนี้' ไปแล้ว"
  - stepId: open_gate
    summary: "สำรวจประตูดวงดาวเพื่อออกไปห้องถัดไป"
    interactionId: unlock_celestial_door
    availableWhen:
    - type: 0
      targetId: sena_passed
      amount: 0
    completedWhen:
    - type: 0
      targetId: room03_entered
      amount: 0
    vagueHint: "นางไปแล้ว... ไม่มีอะไรขวางเราแล้วนะ"
    normalHint: "ทางข้างหน้าน่าจะเปิดแล้วล่ะ"
    explicitHint: "ลองไปดูที่ประตูดวงดาวสิ"
