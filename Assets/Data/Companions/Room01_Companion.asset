%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: c011ab1e000000000000000000000001, type: 3}
  m_Name: Room01_Companion
  m_EditorClassIdentifier:
  scenarioId: room01_alice
  npcId: Alice
  displayName: Alice
  addressNames: ["อลิซ", "อลิส", "Alice"]
  walkBounds:
    serializedVersion: 2
    x: -7.8
    y: -4.3
    width: 15.6
    height: 6
  cellSize: 0.4
  clearance: 0.2
  moveSpeed: 2.6
  moveAcceleration: 6.5
  moveDeceleration: 8
  followDistance: 1.6
  followStartBuffer: 0.45
  activityLabelDistance: 2.4
  walkAnimationPace: 0.55
  commandDistance: 4
  witnessDistance: 5
  taskTimeoutSeconds: 45
  welcomeLine: "...จะไปสำรวจด้วยกันไหม? จะให้ช่วยหาหลักฐานหรือหยุดรอก็บอกฉันได้"
  followLine: "...ก็ได้ ฉันเดินไปด้วย อย่าวิ่งทิ้งกันก็แล้วกัน"
  waitLine: "อืม ฉันรอตรงนี้ ถ้าต้องการให้ช่วยก็เรียกนะ"
  blockedLine: "ฉันไปไม่ถึงตรงนั้น... ขยับมาหากันแล้วลองใหม่ได้ไหม?"
  releaseLine: "...ฉันขอปล่อยมือก่อนนะ จับไว้นานแล้ว ถ้าจะลองอีกครั้งก็ชวนฉันได้"
  comfortLine: "...ขอบใจ ฉันไม่ได้กลัวหรอก แค่โล่งใจที่ไม่ได้อยู่คนเดียว"
  comfortRepeatLine: "อืม ฉันรู้ว่าเธอยังอยู่ตรงนี้ ไปต่อกันเถอะ"
  comfortMemory: "ผู้เล่นบอกว่าจะอยู่ด้วยกันและให้กำลังใจระหว่างสำรวจห้องแรก"
  comfortEmotion: homesickness
  reasoningProfile: {fileID: 11400000, guid: 67e2af4cbdb94250ad954f791c100002, type: 2}
  stations:
  - id: two_hands_box
    title: "กล่องสองมือ"
    propDescription: "กล่องมีจุดจับสองด้าน ต้องมีคนประจำทั้งสองด้านพร้อมกันจึงเปิดได้ ลองชวน Alice มาช่วยจับอีกด้าน แล้วไปยืนฝั่งของคุณ"
    pendingLine: "ยังไม่ได้เปิดเลย... ฉันก็ยังไม่รู้ว่าข้างในมีอะไร ถ้าอยากลองเปิดด้วยกันก็ชวนฉันได้นะ"
    completedStatusLine: "เราเปิดกล่องด้วยกันแล้วนี่... ข้างในมีข้อความว่า 'ไม่มีใครต้องผ่านความมืดตามลำพัง' จำได้ไหม?"
    completedRecallPhrases: ["เปิดกล่องด้วยกัน"]
    gameplayTerms:
    - "กล่องสองมือ"
    - "two-hand box"
    requestAliases: ["กล่องนี้", "กล่อง", "box"]
    questionAliases: ["กล่องนี้", "the box", "this box"]
    instructions: "เราต้องจับกล่องคนละด้านนะ ฉันอยู่ฝั่งนี้ ส่วนเธอไปอีกฝั่ง แล้วเราค่อยลองยกพร้อมกัน ไม่ต้องรีบหรอก"
    actionDescription: "ไปจับ/ยกกล่องสองมือกลางห้องอีกฝั่งหนึ่ง เพื่อช่วยกันเปิดกล่อง"
    companionPoint: {x: -0.9, y: -2.65}
    playerPoint: {x: 0.9, y: -2.65}
    radius: 0.5
    holdSeconds: 3
    conditions: []
    requestLine: "...ได้ ฉันจะไปจับด้านสีฟ้าให้ เธอไปยืนอีกฝั่งนะ แล้วเราค่อยนับพร้อมกัน"
    holdingLine: "จับไว้แล้ว! อีกด้านเป็นของเธอ... หนึ่ง สอง..."
    completedLine: "เปิดแล้ว! ...เห็นไหม คราวนี้ฉันก็ช่วย ไม่ได้แค่ยืนมองเธอทำ"
    memory: "ผู้เล่นกับ Alice แบ่งหน้าที่จับกลไกคนละด้านจนเปิดกล่องสองมือได้ด้วยกัน"
    journalText: "เรากับ Alice เปิดกล่องสองมือด้วยการยืนประจำกลไกคนละด้านพร้อมกัน ด้านในมีแผ่นข้อความว่า 'ไม่มีใครต้องผ่านความมืดตามลำพัง' นี่เป็นความทรงจำร่วมกัน ไม่ใช่รหัสหรือเงื่อนไขผ่านห้อง"
    relationshipReward: 3
  - id: desk_support
    title: "ขอบโต๊ะ"
    pendingLine: "ฉันช่วยประคองขอบโต๊ะให้ได้นะ ส่วนเธอลองสำรวจ อยากให้ช่วยก็บอกฉันได้"
    completedStatusLine: "ตอนนั้นฉันประคองขอบโต๊ะ ส่วนเธอเป็นคนพบกระดาษ เราแบ่งหน้าที่กันได้ดีนะ"
    holdForInteractionId: inspect_desk
    useSceneProp: 1
    invitationLine: "...ขอบโต๊ะโยกนิดหน่อย ถ้าอยากให้จับไว้ให้ก็บอกนะ เธอจะได้ใช้สองมือสำรวจ หรือค่อย ๆ ประคองเองก็ได้"
    trustedInvitationLine: "...เราแบ่งงานกันก็ได้นะ ฉันจับขอบโต๊ะให้ เธอสำรวจ ถ้าอยากลองก็บอกฉัน ฉันรอฟังอยู่"
    cautiousRequestLine: "...ตกลง ฉันจะจับขอบโต๊ะไว้ ส่วนเธอสำรวจนะ อยากให้ปล่อยเมื่อไหร่ก็บอก"
    gameplayTerms:
    - "ขอบโต๊ะ"
    - "desk edge"
    requestAliases: ["โต๊ะ", "โต๊ะทำงาน", "desk", "table"]
    instructions: "ฉันจับฝั่งนี้ไว้ให้ เธอไปอีกฝั่งแล้วลองสำรวจดู อ่านสิ่งที่เจอด้วยตัวเองนะ อยากให้ปล่อยเมื่อไหร่ก็บอก"
    actionDescription: "ไปจับประคองขอบโต๊ะที่โยกไว้ให้ ผู้เล่นจะได้ใช้สองมือสำรวจโต๊ะ"
    companionPoint: {x: -5.7, y: -1.15}
    playerPoint: {x: -4.1, y: -1.15}
    radius: 0.65
    holdSeconds: 3
    conditions:
    - type: 0
      targetId: inspected_painting
      amount: 0
    - type: 1
      targetId: found_note
      amount: 0
    requestLine: "...ได้ ฉันจะไปประคองขอบโต๊ะ เธอเป็นคนสำรวจนะ"
    holdingLine: "จับไว้แล้ว เธอลองสำรวจได้เลย ฉันจะไม่ปล่อยจนกว่าเธอจะเสร็จ"
    completedLine: "เจอแล้วสินะ... ตอนประคองฉันเห็นรอยลูกศรเล็กชี้ซ้ายบนขอบกระดาษด้วย เอาตัวเลขที่เธออ่านมาให้ดู แล้วเราค่อยคิดด้วยกัน"
    memory: "Alice ประคองขอบโต๊ะให้ผู้เล่นใช้สองมือสำรวจ จนผู้เล่นพบกระดาษโน้ตด้วยตัวเอง"
    journalText: "Alice ประคองขอบโต๊ะ ส่วนเราเป็นคนพบกระดาษโน้ต ระหว่างช่วยเธอสังเกตเห็นลูกศรบนขอบกระดาษชี้จากขวาไปซ้าย เราต้องแลกสิ่งที่เห็นกันก่อนสรุป"
    relationshipReward: 2
    completionActions:
    - type: 0
      targetId: companion.room01_alice.search.note_direction.found
      amount: 0
    discoveredFactIds: [note_direction]
  searchRequestLine: "...ได้ ฉันจะเดินตรวจบริเวณรอบ ๆ แล้วบอกหลักฐานที่พบ เธอสำรวจส่วนของเธอได้ ถ้าอยากให้หยุดก็บอกนะ"
  searchFinishedLine: "สำรวจรอบนี้เสร็จแล้ว หลักฐานที่พบอยู่ในสมุด เราทบทวนด้วยกันต่อได้"
  searchSpots:
  - id: note_margin
    point: {x: -4.1, y: -1.15}
    inspectSeconds: 2
    factId: note_direction
    inspectingLine: "...ฉันขอตรวจรอยจางบนขอบกระดาษตรงนี้ก่อน"
    conditions:
    - type: 0
      targetId: found_note
      amount: 0
  - id: discovered_painting
    point: {x: 0, y: 1.3}
    inspectSeconds: 1.5
    factId:
    inspectingLine: "เธอเคยตรวจบริเวณนี้แล้วสินะ ถ้าอยากให้ฉันช่วยคิด เอาสิ่งที่พบมาให้ดูด้วยนะ..."
    conditions:
    - type: 0
      targetId: inspected_painting
      amount: 0
  - id: open_floor
    point: {x: -1.8, y: -3.4}
    inspectSeconds: 1.5
    factId:
    inspectingLine: "ฉันตรวจรอยบนพื้นตรงนี้ก่อน..."
    conditions: []
  - id: box_marks
    point: {x: -0.9, y: -2.65}
    inspectSeconds: 2
    factId: companion_box_marks
    inspectingLine: "ขอดูรอยบนกล่องนี้สักครู่..."
    conditions:
    - type: 1
      targetId: companion.room01_alice.two_hands_box.completed
      amount: 0
  - id: discovered_desk_note
    point: {x: -4.1, y: -1.15}
    inspectSeconds: 2
    factId:
    inspectingLine: "เธอพบกระดาษตรงนี้ใช่ไหม ถ้าอยากทบทวนด้วยกัน เอามาให้ฉันดูได้นะ..."
    conditions:
    - type: 0
      targetId: found_note
      amount: 0
  discussions:
  - id: after_failure
    requiredFacts: [painting_arrow, desk_note]
    conditions:
    - type: 0
      targetId: companion.room01_alice.observed.drawer_failed
      amount: 0
    - type: 1
      targetId: drawer_opened
      amount: 0
    line: "...ฉันเห็นว่าที่ลองไปยังไม่สำเร็จ แต่ผลครั้งเดียวไม่ได้แปลว่าหลักฐานผิด เราแยกสิ่งที่อ่านจริงออกจากสิ่งที่เดาก่อน แล้วเธอค่อยตัดสินใจลองอีกครั้งนะ"
  - id: compare_evidence
    requiredFacts: [painting_arrow, desk_note]
    conditions: []
    line: "ข้อความแรกพาเราไปพบกระดาษอีกชิ้นจริง นี่คือสิ่งที่ตรวจสอบแล้ว แต่ยังไม่ได้ยืนยันว่าสิ่งที่เราคิดจะใช้ได้ทั้งหมด... เธอคิดว่าอะไรเป็นข้อเท็จจริง และอะไรยังเป็นข้อสันนิษฐาน?"
  observations:
  - id: painting_seen
    recallTerms: ["ภาพวาด", "กรอบภาพ", "painting"]
    interactionId: inspect_painting
    success: 1
    line: "เจออะไรแล้วเหรอ? ...ถ้าอยากคิดด้วยกันก็เอามาให้ดูได้นะ"
    memory: "Alice อยู่ใกล้และเห็นผู้เล่นสำรวจภาพวาดในห้องแรก"
    conditions: []
  - id: desk_seen
    followUpPhrases: ["เจอโน้ตแล้ว", "เราพบโน้ตแล้ว", "we found the note"]
    followUpLine: "...ดีแล้วที่เธอไม่มองข้ามมัน ถ้าอยากคิดด้วยกันก็เอาสิ่งที่พบมาให้ฉันดูนะ ฉันจะไม่เดาแทนเธอ"
    recallTerms: ["โต๊ะ", "กระดาษ", "desk", "note"]
    interactionId: inspect_desk
    success: 1
    line: "ดีแล้วที่เราไม่เดินผ่านมันไป... ค่อย ๆ ดูไปด้วยกัน"
    memory: "Alice อยู่ใกล้ขณะผู้เล่นสำรวจโต๊ะสำเร็จและชวนกันทบทวนสิ่งที่พบ"
    conditions: []
  - id: drawer_failed
    followUpPhrases: ["ยังเปิดไม่ออกเลย", "ลองแล้วไม่สำเร็จ", "it did not work"]
    followUpLine: "...ฉันเห็นแล้วว่าครั้งนี้ยังไม่สำเร็จ ไม่เป็นไร เราค่อยแยกหลักฐานกับสิ่งที่เดาแล้วลองกันใหม่ ฉันยังอยู่ตรงนี้"
    recallTerms: ["ลิ้นชัก", "ไม่สำเร็จ", "drawer", "failed"]
    interactionId: open_drawer
    success: 0
    line: "ยังไม่ได้ก็ไม่เป็นไร... พักหายใจนิดหนึ่ง ฉันยังอยู่ตรงนี้"
    memory: "Alice เห็นผู้เล่นลองเปิดลิ้นชักไม่สำเร็จและให้กำลังใจโดยไม่บอกเฉลย"
    conditions:
    - type: 1
      targetId: drawer_opened
      amount: 0
  - id: drawer_seen
    followUpPhrases: ["เราทำได้แล้ว", "เปิดลิ้นชักได้แล้ว", "we did it"]
    followUpLine: "...เธอทำได้แล้ว! เมื่อกี้ฉันก็ลุ้นอยู่เหมือนกัน ขอบใจที่ไม่ยอมแพ้นะ เธอเป็นคนเลือกและลองจนสำเร็จจริง ๆ"
    recallTerms: ["ลิ้นชัก", "drawer"]
    interactionId: open_drawer
    success: 1
    line: "ทำได้แล้วนี่! ...อย่ามองฉันแบบนั้น ฉันก็ลุ้นอยู่เหมือนกัน"
    memory: "Alice เห็นผู้เล่นเปิดลิ้นชักสำเร็จและดีใจไปด้วยกัน"
    conditions: []
