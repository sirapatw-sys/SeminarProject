%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 67e2af4cbdb94250ad954f791c100001, type: 3}
  m_Name: Room01_Reasoning
  npcId: Alice
  insufficientEvidenceLine: "...ฉันยังยืนยันไม่ได้ เราต้องมีหลักฐานที่ทั้งคู่ตรวจสอบได้ก่อน"
  clarifyLine: "...เธอหมายถึงหลักฐานชิ้นไหน และคิดว่ามันเชื่อมกันอย่างไร? ลองเล่าสมมติฐานทีละอย่าง ฉันจะช่วยดูเหตุผลให้"
  rules:
  - id: read_right_to_left
    phrases: ["อ่านจากขวา", "ต้องอ่านจากขวา", "อ่านจากขวาไปซ้าย", "ต้องอ่านจากขวาไปซ้าย", "read from right to left"]
    requiredFacts: [desk_note, note_direction]
    requiredFlags: [found_note]
    excludedFlags: [drawer_opened]
    cautiousLine: "...ยังอย่าเพิ่งมั่นใจเพราะเราเดาตรงกัน ลองแยกสิ่งที่อ่านเห็นจริงกับลำดับที่เธอตั้งใจจะลองก่อน"
    normalLine: "...แนวคิดนั้นสอดคล้องกับทิศลูกศรที่เราเห็น แต่ยังเป็นสมมติฐาน เธอลองตรวจลำดับที่อ่านแล้วเป็นคนทดสอบเองนะ"
    detailedLine: "...ลูกศรชี้ไปทางซ้าย แนวคิดอ่านจากขวาจึงมีหลักฐานรองรับ ลองเทียบตัวเลขบนกระดาษทีละตัวตามทิศนั้น ฉันจะรอดูผลด้วย ยังไม่ถือว่าสำเร็จจนกว่าเธอจะทดสอบ"
    insufficientLine: "...ฉันยังไม่มีข้อมูลที่ยืนยันแนวคิดนี้ครบ เอาสิ่งที่เธอพบมาให้ดู หรือชวนฉันไปสำรวจ แล้วเราค่อยประเมินกัน"
  - id: read_left_to_right
    phrases: ["อ่านจากซ้าย", "ต้องอ่านจากซ้าย", "อ่านจากซ้ายไปขวา", "ต้องอ่านจากซ้ายไปขวา", "read from left to right"]
    requiredFacts: [desk_note, note_direction]
    requiredFlags: [found_note]
    excludedFlags: [drawer_opened]
    cautiousLine: "...ฉันยังไม่อยากยืนยันตามความเคยชิน ลองตรวจว่าหลักฐานทุกชิ้นเข้ากับแนวคิดนี้ไหม"
    normalLine: "...แนวคิดนี้มีจุดที่ขัดกับทิศลูกศรที่เราพบ ลองตรวจตรงนั้นอีกที แล้วเธอค่อยเลือกว่าจะทดลองอย่างไร"
    detailedLine: "...ลูกศรบนขอบกระดาษชี้ไปทางซ้าย การอ่านจากซ้ายไปขวาจึงยังขัดกับสิ่งที่เห็น ฉันจะยังไม่ยืนยันสมมติฐานนี้ ลองหาวิธีอ่านที่สอดคล้องกับหลักฐานทั้งสองชิ้น"
    insufficientLine: "...ฉันยังไม่มีหลักฐานครบ จะบอกว่าถูกหรือผิดตอนนี้ก็เป็นการเดา เอาสิ่งที่เธอพบมาให้ดูด้วยนะ"
