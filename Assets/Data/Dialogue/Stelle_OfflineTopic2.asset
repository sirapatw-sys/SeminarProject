MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Stelle_OfflineTopic2
  m_EditorClassIdentifier: 
  dialogueId: stelle_offline_2
  speakerId: Stelle
  speakerName: "สเตล (Stelle)"
  speakerPortrait: {fileID: 21300000, guid: c9c59aaa5dbe4114a1e627ffb5454328, type: 3}
  personalityPrompt: 
  lines:
  - "[:shock] วะ...ว้าย! อ๊ะ...ขอโทษค่ะ นึกว่าเงาอะไร"
  - "สเตลกลัวความมืดค่ะ ขอยืนใกล้ๆ คุณสักพักได้ไหมคะ"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ได้สิ อยู่ใกล้ๆ ได้เลย"
    responseText: "[:flustered] ขะ...ขอบคุณค่ะ แค่นี้ก็อุ่นใจขึ้นเยอะเลยค่ะ"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Stelle
      secondaryId: 
      amount: 0
      text: "ผู้เล่นให้สเตลยืนใกล้ๆ ตอนที่เธอกลัวความมืด"
  - optionText: "เธอกลัวมืดมานานแล้วเหรอ"
    responseText: "[:flustered] ตั้งแต่เด็กแล้วค่ะ ...แต่อยู่ที่นี่มันแย่กว่าเดิมอีกค่ะ"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: 1
      text: 
  - optionText: "เดี๋ยวก่อนนะ กำลังยุ่ง"
    responseText: "[:cry] อ๊ะ...คะ-ค่ะ สเตลจะยืนตรงนี้เงียบๆ ค่ะ"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
