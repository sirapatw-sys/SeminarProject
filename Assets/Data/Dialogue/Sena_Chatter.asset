  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Sena_Chatter
  m_EditorClassIdentifier:
  dialogueId: "sena_chatter"
  speakerId: "Sena"
  speakerName: "เซนะ (Sena)"
  speakerPortrait: {fileID: 21300000, guid: 1d146046dd6d494f921da5feb73d96ba, type: 3}
  personalityPrompt: ""
  lines:
  - "มนุษย์เอ๋ย... ข้ามีเรื่องจะไถ่ถามเจ้าสักประการ"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ตั้งใจฟัง แล้วตอบอย่างให้เกียรติ"
    responseText: "หึ... มนุษย์ผู้รู้จักฟัง หาได้ยากนักในครานี้"
    actions:
    - type: 4
      targetId: "Sena"
      secondaryId: ""
      amount: 3
      text: ""
    - type: 7
      targetId: "Sena"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นตั้งใจฟังตอนที่ Sena ชวนคุยเอง"
  - optionText: "ถามกลับว่าเหตุใดจึงสนใจเรื่องนี้"
    responseText: "เจ้าช่างถามนัก... แต่ก็เถิด ข้าจักบอก"
    actions:
    - type: 4
      targetId: "Sena"
      secondaryId: ""
      amount: 1
      text: ""
  - optionText: "บอกว่าไม่มีเวลาคุยตอนนี้"
    responseText: "จงไปเถิด ข้ามิได้ง้อผู้ใด"
    actions:
    - type: 4
      targetId: "Sena"
      secondaryId: ""
      amount: -2
      text: ""
  firstMeetingChoicesOnly: 0
