  speakerPortrait: {fileID: 21300000, guid: ab111111111111111111111111111111, type: 3}
  personalityPrompt: ""
  lines:
  - "...นี่ ว่างคุยสักหน่อยไหม"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ตั้งใจฟัง แล้วคุยเรื่องนี้ต่อ"
    responseText: "...ขอบใจนะ ที่ยอมฟังเรื่องแบบนี้"
    actions:
    - type: 4
      targetId: "Alice"
      secondaryId: ""
      amount: 3
      text: ""
    - type: 7
      targetId: "Alice"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นตั้งใจฟังตอนที่ Alice ชวนคุยเอง"
  - optionText: "ถามกลับสั้นๆ ว่าทำไมถึงคิดเรื่องนี้"
    responseText: "...ก็แค่คิดขึ้นมาเฉยๆ ไม่มีอะไรหรอก"
    actions:
    - type: 4
      targetId: "Alice"
      secondaryId: ""
      amount: 1
      text: ""
  - optionText: "ขอตัวก่อน กำลังยุ่งอยู่"
    responseText: "...อืม ไปเถอะ"
    actions:
    - type: 4
      targetId: "Alice"
      secondaryId: ""
      amount: -2
      text: ""
  firstMeetingChoicesOnly: 0
