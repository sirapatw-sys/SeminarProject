  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Alice_Intro
  m_EditorClassIdentifier: 
  dialogueId: alice_intro
  speakerId: Alice
  speakerName: Alice
  speakerPortrait: {fileID: 21300000, guid: ab111111111111111111111111111111, type: 3}
  lines:
  - "\u0E09\u0E31\u0E19\u0E08\u0E33\u0E44\u0E14\u0E49\u0E27\u0E48\u0E32\u0E01\u0E38\u0E0D\u0E41\u0E08\u0E22\u0E31\u0E07\u0E2D\u0E22\u0E39\u0E48\u0E43\u0E19\u0E2B\u0E49\u0E2D\u0E07\u0E19\u0E35\u0E49..."
  - "\u0E41\u0E15\u0E48\u0E09\u0E31\u0E19\u0E08\u0E33\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E27\u0E48\u0E32\u0E40\u0E01\u0E47\u0E1A\u0E44\u0E27\u0E49\u0E17\u0E35\u0E48\u0E44\u0E2B\u0E19"
  - "\u0E0A\u0E48\u0E27\u0E22\u0E09\u0E31\u0E19\u0E2B\u0E32\u0E21\u0E31\u0E19\u0E2B\u0E19\u0E48\u0E2D\u0E22\u0E44\u0E14\u0E49\u0E44\u0E2B\u0E21?"
  choices:
  - optionText: "\u0E44\u0E14\u0E49 \u0E09\u0E31\u0E19\u0E08\u0E30\u0E0A\u0E48\u0E27\u0E22\u0E2B\u0E32\u0E43\u0E2B\u0E49"
    responseText: "\u0E02\u0E2D\u0E1A\u0E04\u0E38\u0E13\u0E19\u0E30 \u0E09\u0E31\u0E19\u0E04\u0E34\u0E14\u0E27\u0E48\u0E32\u0E40\u0E23\u0E32\u0E19\u0E48\u0E32\u0E08\u0E30\u0E2B\u0E32\u0E40\u0E08\u0E2D\u0E14\u0E49\u0E27\u0E22\u0E01\u0E31\u0E19"
    actions:
    - type: 4
      targetId: Alice
      amount: 5
      text: 
  - optionText: "\u0E17\u0E33\u0E44\u0E21\u0E09\u0E31\u0E19\u0E15\u0E49\u0E2D\u0E07\u0E0A\u0E48\u0E27\u0E22\u0E40\u0E18\u0E2D?"
    responseText: "\u0E01\u0E47\u0E44\u0E14\u0E49... \u0E09\u0E31\u0E19\u0E08\u0E30\u0E2B\u0E32\u0E15\u0E48\u0E2D\u0E40\u0E2D\u0E07"
    actions:
    - type: 4
      targetId: Alice
      amount: 1
      text: 
  - optionText: "\u0E09\u0E31\u0E19\u0E44\u0E21\u0E48\u0E27\u0E48\u0E32\u0E07"
    responseText: "\u0E40\u0E02\u0E49\u0E32\u0E43\u0E08\u0E41\u0E25\u0E49\u0E27... \u0E09\u0E31\u0E19\u0E08\u0E30\u0E44\u0E21\u0E48\u0E23\u0E1A\u0E01\u0E27\u0E19\u0E40\u0E18\u0E2D"
    actions:
    - type: 4
      targetId: Alice
      amount: -3
      text: 
