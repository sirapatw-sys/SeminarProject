  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Stelle_Chatter
  m_EditorClassIdentifier: 
  dialogueId: stelle_offline_1
  speakerId: Stelle
  speakerName: "\u0E2A\u0E40\u0E15\u0E25 (Stelle)"
  speakerPortrait: {fileID: 21300000, guid: c9c59aaa5dbe4114a1e627ffb5454328, type: 3}
  personalityPrompt: 
  lines:
  - "\u0E04\u0E27\u0E32\u0E21\u0E40\u0E07\u0E35\u0E22\u0E1A\u0E43\u0E19\u0E19\u0E35\u0E49\u0E17\u0E33\u0E43\u0E2B\u0E49\u0E40\u0E23\u0E32\u0E01\u0E31\u0E07\u0E27\u0E25
    \u0E2D\u0E22\u0E39\u0E48\u0E04\u0E38\u0E22\u0E40\u0E1B\u0E47\u0E19\u0E40\u0E1E\u0E37\u0E48\u0E2D\u0E19\u0E2A\u0E31\u0E01\u0E2B\u0E19\u0E48\u0E2D\u0E22\u0E44\u0E14\u0E49\u0E44\u0E2B\u0E21?"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "\u0E40\u0E25\u0E48\u0E32\u0E43\u0E2B\u0E49\u0E40\u0E23\u0E32\u0E1F\u0E31\u0E07\u0E44\u0E14\u0E49\u0E19\u0E30"
    responseText: "\u0E02\u0E2D\u0E1A\u0E43\u0E08\u0E19\u0E30 \u0E41\u0E04\u0E48\u0E21\u0E35\u0E04\u0E19\u0E1F\u0E31\u0E07\u0E01\u0E47\u0E0A\u0E48\u0E27\u0E22\u0E41\u0E25\u0E49\u0E27"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Stelle
      secondaryId: 
      amount: 0
      text: "\u0E1C\u0E39\u0E49\u0E40\u0E25\u0E48\u0E19\u0E15\u0E31\u0E49\u0E07\u0E43\u0E08\u0E1F\u0E31\u0E07\u0E15\u0E2D\u0E19\u0E17\u0E35\u0E48
        Stelle \u0E0A\u0E27\u0E19\u0E04\u0E38\u0E22\u0E40\u0E2D\u0E07"
  - optionText: "\u0E2D\u0E37\u0E21 \u0E40\u0E23\u0E32\u0E1F\u0E31\u0E07\u0E2D\u0E22\u0E39\u0E48"
    responseText: "\u0E2D\u0E22\u0E48\u0E32\u0E07\u0E19\u0E49\u0E2D\u0E22\u0E40\u0E23\u0E32\u0E01\u0E47\u0E44\u0E21\u0E48\u0E44\u0E14\u0E49\u0E2D\u0E22\u0E39\u0E48\u0E04\u0E19\u0E40\u0E14\u0E35\u0E22\u0E27"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: 1
      text: 
  - optionText: "\u0E15\u0E2D\u0E19\u0E19\u0E35\u0E49\u0E40\u0E23\u0E32\u0E44\u0E21\u0E48\u0E2D\u0E22\u0E32\u0E01\u0E04\u0E38\u0E22"
    responseText: "\u0E44\u0E14\u0E49... \u0E44\u0E27\u0E49\u0E04\u0E38\u0E22\u0E01\u0E31\u0E19\u0E17\u0E35\u0E2B\u0E25\u0E31\u0E07"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
