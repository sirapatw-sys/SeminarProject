  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Stelle_OfflineTopic1
  m_EditorClassIdentifier: 
  dialogueId: stelle_offline_1
  speakerId: Stelle
  speakerName: "สเตล (Stelle)"
  speakerPortrait: {fileID: 21300000, guid: c9c59aaa5dbe4114a1e627ffb5454328, type: 3}
  personalityPrompt: 
  lines:
  - "[:flustered] คุณคะ... รินะดุสเตลอีกแล้วค่ะ"
  - "แต่สเตลรู้ว่ารินะไม่ได้ใจร้ายหรอกนะคะ แค่...พูดแรงไปหน่อย"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "รินะเป็นห่วงสเตลนั่นแหละ"
    responseText: "[:flustered] จะ...จริงเหรอคะ ฮือ สเตลจะพยายามไม่ร้องไห้ง่ายๆ แล้วค่ะ"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Stelle
      secondaryId: 
      amount: 0
      text: "ผู้เล่นบอกสเตลว่ารินะเป็นห่วงเธอ"
  - optionText: "รินะดุเรื่องอะไรเหรอ"
    responseText: "[:blank] เรื่องที่สเตลกรี๊ดเสียงดังน่ะค่ะ ...ก็มันน่ากลัวนี่คะ"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: 1
      text: 
  - optionText: "เป็นเรื่องของสองคนนะ"
    responseText: "[:cry] ค่ะ...ขอโทษค่ะ สเตลไม่น่าเล่าเลย"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
