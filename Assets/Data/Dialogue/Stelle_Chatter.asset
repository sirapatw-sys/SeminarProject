MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Stelle_Chatter
  m_EditorClassIdentifier:
  dialogueId: "stelle_chatter"
  speakerId: "Stelle"
  speakerName: "สเตล (Stelle)"
  speakerPortrait: {fileID: 21300000, guid: c9c59aaa5dbe4114a1e627ffb5454328, type: 3}
  personalityPrompt: ""
  lines:
  - "[:flustered] คะ...คุณคะ! ขอคุยด้วยสักแป๊บได้ไหมคะ..."
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ตั้งใจฟัง แล้วคุยเรื่องนี้ต่อ"
    responseText: "[:flustered] ขะ...ขอบคุณที่ฟังนะคะ"
    actions:
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: 3
      text: ""
    - type: 7
      targetId: "Stelle"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นตั้งใจฟังตอนที่ Stelle ชวนคุยเอง"
  - optionText: "ถามกลับสั้นๆ ว่าทำไมถึงคิดเรื่องนี้"
    responseText: "[:flustered] อะ...ก็แค่อยากคุยด้วยเฉยๆ ค่ะ"
    actions:
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: 1
      text: ""
  - optionText: "ขอตัวก่อน กำลังยุ่งอยู่"
    responseText: "[:cry] อ๊ะ...คะ-ค่ะ ขอโทษที่กวนค่ะ..."
    actions:
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: -2
      text: ""
  firstMeetingChoicesOnly: 0
