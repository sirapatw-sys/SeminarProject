  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Rina_OfflineTopic1
  m_EditorClassIdentifier: 
  dialogueId: rina_offline_1
  speakerId: Rina
  speakerName: "รินะ (Rina)"
  speakerPortrait: {fileID: 21300000, guid: 077f8282b9ce40a0b6b8fbec133e9c20, type: 3}
  personalityPrompt: 
  lines:
  - "นี่ นาย ช่วยดูสเตลให้หน่อยได้ไหม"
  - "ยัยนั่นไม่ยอมพูดหรอก แต่ฉันรู้ว่ากลัวจนนอนไม่หลับ"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ได้สิ ฉันจะคอยดูเธอให้"
    responseText: "ขอบใจ... อย่าไปบอกยัยนั่นนะว่าฉันเป็นคนขอ"
    actions:
    - type: 4
      targetId: Rina
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Rina
      secondaryId: 
      amount: 0
      text: "ผู้เล่นรับปากรินะว่าจะช่วยดูแลสเตล"
  - optionText: "ทำไมไม่บอกเธอเองล่ะ"
    responseText: "ถ้าฉันพูดเอง เดี๋ยวยัยนั่นก็คิดว่าฉันดุอีก"
    actions:
    - type: 4
      targetId: Rina
      secondaryId: 
      amount: 1
      text: 
  - optionText: "เธอดูแลเองก็ได้นี่"
    responseText: "ก็ได้ ไม่ได้หวังอะไรมากอยู่แล้ว"
    actions:
    - type: 4
      targetId: Rina
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
