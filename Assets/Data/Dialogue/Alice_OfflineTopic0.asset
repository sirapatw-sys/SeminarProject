  dialogueId: alice_offline_0
  speakerId: Alice
  speakerName: "Alice"
  speakerPortrait: {fileID: 21300000, guid: ab111111111111111111111111111111, type: 3}
  personalityPrompt: 
  lines:
  - "...เธอคิดถึงบ้านบ้างไหม"
  - "ฉันจำได้แค่ว่ากำลังเดินกลับบ้านตอนหัวค่ำ... แล้วก็มาโผล่ที่นี่"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "คิดถึงสิ เดี๋ยวเราได้กลับบ้านแน่"
    responseText: "...อืม หวังว่าจะจริงอย่างที่เธอว่า"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Alice
      secondaryId: 
      amount: 0
      text: "ผู้เล่นตั้งใจฟังตอนที่ Alice เล่าว่าคิดถึงบ้าน"
  - optionText: "ทำไมจู่ๆ ถึงถามแบบนี้ล่ะ"
    responseText: "...ก็แค่นึกขึ้นมาได้ ไม่มีอะไรหรอก"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: 1
      text: 
  - optionText: "ไว้ค่อยคุยตอนออกไปได้แล้วกัน"
    responseText: "...ก็ได้ ฉันไม่ได้อยากคุยขนาดนั้นหรอก"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
