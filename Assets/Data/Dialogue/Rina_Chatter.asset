  dialogueId: "rina_chatter"
  speakerId: "Rina"
  speakerName: "รินะ (Rina)"
  speakerPortrait: {fileID: 21300000, guid: 077f8282b9ce40a0b6b8fbec133e9c20, type: 3}
  personalityPrompt: ""
  lines:
  - "นี่ นาย... มีเรื่องอยากถามหน่อย"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ตั้งใจฟัง แล้วคุยเรื่องนี้ต่อ"
    responseText: "...ก็ดี คุยกับนายแล้วห้องนี้เงียบน้อยลงหน่อย"
    actions:
    - type: 4
      targetId: "Rina"
      secondaryId: ""
      amount: 3
      text: ""
    - type: 7
      targetId: "Rina"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นตั้งใจฟังตอนที่ Rina ชวนคุยเอง"
  - optionText: "ถามกลับสั้นๆ ว่าทำไมถึงคิดเรื่องนี้"
    responseText: "ไม่มีอะไรมากหรอก แค่คิดดังไปหน่อย"
    actions:
    - type: 4
      targetId: "Rina"
      secondaryId: ""
      amount: 1
      text: ""
  - optionText: "ขอตัวก่อน กำลังยุ่งอยู่"
    responseText: "อ้อ งั้นก็ตามสบาย"
    actions:
    - type: 4
      targetId: "Rina"
      secondaryId: ""
      amount: -2
      text: ""
  firstMeetingChoicesOnly: 0
