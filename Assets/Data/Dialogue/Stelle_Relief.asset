  dialogueId: "stelle_relief"
  speakerId: "Stelle"
  speakerName: "สเตล (Stelle)"
  speakerPortrait: {fileID: 21300000, guid: c9c59aaa5dbe4114a1e627ffb5454328, type: 3}
  personalityPrompt: ""
  lines:
  - "[:cry] เทียนกลับเป็นสีส้มแล้ว... ผีคงหลับไปแล้วใช่ไหมคะ ฮือ..."
  - "[:flustered] ขะ...ขอบคุณนะคะ ที่ไม่ทิ้งสเตลไว้ตอนนั้น"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ออกไปด้วยกันนะ สเตล"
    responseText: "[:flustered] ด...ได้ค่ะ! สเตลจะไม่ร้องไห้แล้วค่ะ!"
    actions:
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: 5
      text: ""
    - type: 0
      targetId: "stelle_trusts_player"
      secondaryId: ""
      amount: 0
      text: ""
    - type: 7
      targetId: "Stelle"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นชวนสเตลออกไปด้วยกัน"
  - optionText: "เธอเก่งมากเลยนะที่อดทนมาได้"
    responseText: "[:flustered] มะ...ไม่เห็นเก่งเลยค่ะ! ...แต่ขอบคุณนะคะ"
    actions:
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: 4
      text: ""
  - optionText: "ไปกันได้แล้ว"
    responseText: "[:blank] ...ค่ะ"
    actions: []
  firstMeetingChoicesOnly: 0
