--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Sena_Impatient
  m_EditorClassIdentifier: 
  dialogueId: "sena_impatient"
  speakerId: "Sena"
  speakerName: "เซนะ (Sena)"
  speakerPortrait: {fileID: 21300000, guid: 1d146046dd6d494f921da5feb73d96ba, type: 3}
  personalityPrompt: ""
  lines:
  - "เจ้ายังวนเวียนอยู่ในหอนี้อีกฤๅ มนุษย์"
  - "ฝุ่นในหอนี้ยังขยับเร็วกว่าเจ้าเสียอีก... จารึกนั้นมิได้เดินมาหาเจ้าเองดอก"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ขอเวลาอีกนิด"
    responseText: "หึ เวลาของมนุษย์ช่างสั้นนัก จงใช้มันให้คุ้มเถิด"
    actions:
    - type: 4
      targetId: "Sena"
      secondaryId: ""
      amount: 1
      text: ""
  - optionText: "ช่วยบอกหน่อยได้ไหมว่ามันอยู่ที่ไหน"
    responseText: "ข้ามิใช่พี่เลี้ยงของเจ้าดอก จงใช้ตาที่ติดหัวมานั่นเสาะหาเอาเองเถิด"
    actions:
    - type: 4
      targetId: "Sena"
      secondaryId: ""
      amount: -3
      text: ""
  - optionText: "เงียบไปเลย"
    responseText: "บังอาจ! ...ข้าจะจดจำความหยาบคายของเจ้าไว้ มนุษย์"
    actions:
    - type: 4
      targetId: "Sena"
      secondaryId: ""
      amount: -5
      text: ""
    - type: 7
      targetId: "Sena"
      secondaryId: ""
      amount: 0
      text: "มนุษย์ผู้นี้บังอาจสั่งให้ข้าเงียบ"
  firstMeetingChoicesOnly: 0
