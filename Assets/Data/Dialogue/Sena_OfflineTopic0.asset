MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Sena_OfflineTopic0
  m_EditorClassIdentifier: 
  dialogueId: sena_offline_0
  speakerId: Sena
  speakerName: "เซนะ (Sena)"
  speakerPortrait: {fileID: 21300000, guid: 1d146046dd6d494f921da5feb73d96ba, type: 3}
  personalityPrompt: 
  lines:
  - "สามพันฤดูแล้วที่ข้ายืนอยู่ตรงนี้"
  - "มนุษย์เอ๋ย เจ้าคงมิอาจเข้าใจความยาวนานเช่นนั้นดอก"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ฟังดูโดดเดี่ยวมากเลยนะ"
    responseText: "โดดเดี่ยวฤๅ... หึ เจ้าช่างกล้าคิดแทนข้านัก ...แต่ครานี้ข้าจะมิถือสาเจ้า"
    actions:
    - type: 4
      targetId: Sena
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Sena
      secondaryId: 
      amount: 0
      text: "ผู้เล่นรับฟังเซนะเล่าถึงสามพันฤดูที่นางเฝ้าประตู"
  - optionText: "ท่านไม่เบื่อบ้างเหรอ"
    responseText: "นางฟ้ามิรู้จักความเบื่อหน่ายดอก ...อย่าได้ถามซ้ำอีกเลย"
    actions:
    - type: 4
      targetId: Sena
      secondaryId: 
      amount: 1
      text: 
  - optionText: "ฉันไม่มีเวลาฟังหรอก"
    responseText: "หึ มนุษย์ช่างไร้ความอดทน จงไปเถิด"
    actions:
    - type: 4
      targetId: Sena
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
