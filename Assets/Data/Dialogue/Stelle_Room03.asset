MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Stelle_Room03
  m_EditorClassIdentifier: 
  dialogueId: "stelle_room03"
  speakerId: "Stelle"
  speakerName: "สเตล (Stelle)"
  speakerPortrait: {fileID: 21300000, guid: c9c59aaa5dbe4114a1e627ffb5454328, type: 3}
  personalityPrompt: ""
  lines:
  - "[:shock] ว้าย! ...อ๊ะ ขะ...ขอโทษค่ะ นึกว่าผี..."
  - "[:flustered] คะ...คุณเป็นใครคะ? ติดอยู่ที่นี่เหมือนกันเหรอคะ?"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ไม่ต้องกลัว ฉันก็ติดอยู่ที่นี่เหมือนกัน"
    responseText: "[:cry] จะ...จริงเหรอคะ ฮือ... ดีจังที่มีคนมาเพิ่มอีกคน"
    actions:
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: 6
      text: ""
    - type: 7
      targetId: "Stelle"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นบอกสเตลว่าไม่ต้องกลัว ตอนเจอกันครั้งแรก"
  - optionText: "เธอชื่ออะไรเหรอ?"
    responseText: "[:flustered] สะ...สเตลค่ะ! ชื่อสเตล... ยะ...ยินดีที่ได้รู้จักค่ะ"
    actions:
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: 2
      text: ""
  - optionText: "(เดินจากไปเงียบๆ)"
    responseText: "[:cry] อ๊ะ... ไปแล้วเหรอคะ..."
    actions: []
  firstMeetingChoicesOnly: 1
