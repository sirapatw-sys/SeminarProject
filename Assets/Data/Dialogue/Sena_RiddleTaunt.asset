  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Sena_RiddleTaunt
  m_EditorClassIdentifier: 
  dialogueId: "sena_riddle_taunt"
  speakerId: "Sena"
  speakerName: "เซนะ (Sena)"
  speakerPortrait: {fileID: 21300000, guid: 1d146046dd6d494f921da5feb73d96ba, type: 3}
  personalityPrompt: ""
  lines:
  - "เงียบงันเช่นนี้ แปลว่าเจ้ายังคิดมิออกฤๅ"
  - "ข้าจะเอ่ยซ้ำให้อีกคราเดียว:"
  - "'ข้าวิ่งนำหน้าเจ้าอยู่เสมอ ทว่ามิเคยไปถึงแห่งหนใด เจ้าเฝ้ารอข้าไปทั้งชีวิต แต่ครานที่ข้ามาถึงเจ้าจริงๆ ชื่อของข้าก็เปลี่ยนไปเสียแล้ว... ข้าคือสิ่งใด?'\n(I am always running ahead of you, yet I never arrive. You spend your life anticipating me, but the moment I reach you, my name has already changed. What am I?)"
  - "จงพิมพ์คำตอบมาเถิด"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ขอคิดอีกนิด"
    responseText: "จงคิดเถิด ข้ามีเวลาเหลือเฟือ เจ้าต่างหากที่มิมี"
    actions: []
  - optionText: "ยอมแพ้"
    responseText: "มนุษย์ช่างไร้ความอดทน... ประตูนี้รอได้ชั่วนิรันดร์ เจ้าเล่า รอได้นานเท่าใด"
    actions:
    - type: 4
      targetId: "Sena"
      secondaryId: ""
      amount: -2
      text: ""
  firstMeetingChoicesOnly: 0
