%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Alice_PromiseMissed
  m_EditorClassIdentifier:
  dialogueId: alice_promise_missed
  speakerId: Alice
  speakerName: Alice
  lines:
  - "...เธอเปิดลิ้นชักได้แล้วสินะ แต่ยังไม่ได้เอาหลักฐานกลับมาให้ฉันดูเลย"
  - "ฉันไม่ได้อยากขวางการหาทางออก แค่คิดว่าเราตกลงจะคุยเรื่องที่เจอด้วยกัน"
  choices:
  - optionText: "ขอโทษ ฉันมัวแต่รีบ เดี๋ยวเอามาให้ดู"
    responseText: "...เข้าใจ ครั้งหน้าบอกกันก่อนก็พอ โน้ตยังเอามาคุยได้ ฉันไม่ได้ปิดโอกาสหรอก"
    actions:
    - type: 0
      targetId: alice_evidence_arc.resolved
    - type: 0
      targetId: alice_evidence_arc.neglected
    - type: 4
      targetId: Alice
      amount: -1
    - type: 7
      targetId: Alice
      text: "ผู้เล่นไม่ได้กลับมาให้ดูหลักฐานตามสัญญา แต่ขอโทษและยอมรับว่ามัวแต่รีบ"
  - optionText: "ออกจากห้องได้ก็พอ ไม่จำเป็นต้องรายงานทุกอย่าง"
    responseText: "...งั้นคราวหน้าก็อย่ารับปาก ฉันจะได้ไม่รอ"
    actions:
    - type: 0
      targetId: alice_evidence_arc.resolved
    - type: 0
      targetId: alice_evidence_arc.neglected
    - type: 4
      targetId: Alice
      amount: -5
    - type: 9
      targetId: Alice
      secondaryId: homesickness
      amount: 10
    - type: 7
      targetId: Alice
      text: "ผู้เล่นไม่ได้ทำตามสัญญาและบอกว่าไม่จำเป็นต้องนำหลักฐานมาคุยกับ Alice"
