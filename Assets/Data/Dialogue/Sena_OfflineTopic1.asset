  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Sena_OfflineTopic1
  m_EditorClassIdentifier: 
  dialogueId: sena_offline_1
  speakerId: Sena
  speakerName: "เซนะ (Sena)"
  speakerPortrait: {fileID: 21300000, guid: 1d146046dd6d494f921da5feb73d96ba, type: 3}
  personalityPrompt: 
  lines:
  - "ข้าเห็นผู้เช่นเจ้ามาแล้วนับร้อย ล้วนผุพังอยู่ในหอสมุดนี้"
  - "เจ้าคิดว่าเจ้าจะต่างจากพวกนั้นฤๅ"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ฉันจะพยายามให้ดีที่สุด"
    responseText: "คำพูดของมนุษย์นั้นเบานัก ...แต่ข้าจะคอยดูเจ้า"
    actions:
    - type: 4
      targetId: Sena
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Sena
      secondaryId: 
      amount: 0
      text: "ผู้เล่นบอกเซนะว่าจะพยายามให้ดีที่สุด"
  - optionText: "คนพวกนั้นเป็นอย่างไรบ้าง"
    responseText: "ล้วนโอหัง ล้วนเร่งร้อน และล้วนจบลงเช่นเดียวกัน"
    actions:
    - type: 4
      targetId: Sena
      secondaryId: 
      amount: 1
      text: 
  - optionText: "ไม่ต้องห่วงฉันหรอก"
    responseText: "ห่วงฤๅ ข้ามิเคยห่วงมนุษย์ผู้ใดดอก"
    actions:
    - type: 4
      targetId: Sena
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
