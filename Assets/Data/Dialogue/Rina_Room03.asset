MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Rina_Room03
  m_EditorClassIdentifier: 
  dialogueId: "rina_room03"
  speakerId: "Rina"
  speakerName: "รินะ (Rina)"
  speakerPortrait: {fileID: 21300000, guid: 077f8282b9ce40a0b6b8fbec133e9c20, type: 3}
  personalityPrompt: ""
  lines:
  - "นายก็ตื่นมาในที่แบบนี้เหมือนกันสินะ"
  - "ฉันชื่อรินะ ติดอยู่ที่นี่มาสามวันแล้ว — นับจากเทียนที่ละลายไปน่ะ"
  - "ยัยที่ตัวสั่นอยู่ตรงโซฟานั่นชื่อสเตล อย่าไปทำให้ตกใจล่ะ เดี๋ยวเสียงกรี๊ดจะปลุกผีทั้งหลัง"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ห้องนี้มีอะไรแปลกๆ บ้าง?"
    responseText: "เทียนเป็นสีฟ้าเอง เก้าอี้โยกเอง แล้วก็มีเพลงกล่อมเด็กดังทุกครั้งที่เทียนเปลี่ยนสี... ปกติดีออก สำหรับบ้านผีน่ะ"
    actions:
    - type: 0
      targetId: "talked_to_rina_r3"
      secondaryId: ""
      amount: 0
      text: ""
    - type: 4
      targetId: "Rina"
      secondaryId: ""
      amount: 1
      text: ""
  - optionText: "ยินดีที่ได้รู้จัก"
    responseText: "อืม เหมือนกัน ...ถ้าเรารอดออกไปได้นะ"
    actions:
    - type: 0
      targetId: "talked_to_rina_r3"
      secondaryId: ""
      amount: 0
      text: ""
    - type: 4
      targetId: "Rina"
      secondaryId: ""
      amount: 3
      text: ""
    - type: 7
      targetId: "Rina"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นทักทายอย่างสุภาพตอนเจอกันครั้งแรก"
  - optionText: "เธอดูไม่กลัวเลยนะ"
    responseText: "กลัวไปก็ไม่ได้ช่วยให้ประตูเปิด ...อีกอย่าง มีคนกลัวแทนฉันไปเยอะแล้ว"
    actions:
    - type: 0
      targetId: "talked_to_rina_r3"
      secondaryId: ""
      amount: 0
      text: ""
    - type: 4
      targetId: "Rina"
      secondaryId: ""
      amount: 2
      text: ""
  firstMeetingChoicesOnly: 1
