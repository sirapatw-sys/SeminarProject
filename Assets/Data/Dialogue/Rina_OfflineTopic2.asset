  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Rina_OfflineTopic2
  m_EditorClassIdentifier: 
  dialogueId: rina_offline_2
  speakerId: Rina
  speakerName: "รินะ (Rina)"
  speakerPortrait: {fileID: 21300000, guid: 077f8282b9ce40a0b6b8fbec133e9c20, type: 3}
  personalityPrompt: 
  lines:
  - "ฉันนับวันจากเทียนที่ละลายไป ตอนนี้ก็ราวสามวันแล้ว"
  - "ถ้านายยังตามนับอยู่ ช่วยบอกด้วยว่าเลขตรงกับฉันไหม"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ขอบใจที่คอยนับไว้นะ"
    responseText: "ไม่มีอะไรทำนี่ นับไว้อย่างน้อยก็รู้ว่ายังมีสติอยู่"
    actions:
    - type: 4
      targetId: Rina
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Rina
      secondaryId: 
      amount: 0
      text: "ผู้เล่นขอบใจรินะที่คอยนับวันไว้"
  - optionText: "นับไปแล้วรู้สึกยังไงบ้าง"
    responseText: "ก็เหนื่อยนิดหน่อย แต่ยังดีกว่านั่งรอเฉยๆ"
    actions:
    - type: 4
      targetId: Rina
      secondaryId: 
      amount: 1
      text: 
  - optionText: "ไม่ต้องนับหรอก"
    responseText: "อ้อ แล้วแต่นาย"
    actions:
    - type: 4
      targetId: Rina
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
