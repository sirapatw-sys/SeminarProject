  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Sena_OfflineTopic3
  m_EditorClassIdentifier: 
  dialogueId: sena_offline_3
  speakerId: Sena
  speakerName: "เซนะ (Sena)"
  speakerPortrait: {fileID: 21300000, guid: 1d146046dd6d494f921da5feb73d96ba, type: 3}
  personalityPrompt: 
  lines:
  - "มนุษย์เอ๋ย เจ้ายังจำบ้านของเจ้าได้อยู่หรือไม่"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "จำได้สิ ฉันอยากกลับไปให้ได้"
    responseText: "ความปรารถนาของมนุษย์นั้นงดงามอยู่บ้าง ...แม้จะไร้ประโยชน์ก็ตาม"
    actions:
    - type: 4
      targetId: Sena
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Sena
      secondaryId: 
      amount: 0
      text: "ผู้เล่นบอกเซนะว่าอยากกลับบ้านให้ได้"
  - optionText: "แล้วท่านมีบ้านไหม"
    responseText: "ประตูบานนี้คือที่ของข้า เจ้ามิต้องสงสารข้าดอก"
    actions:
    - type: 4
      targetId: Sena
      secondaryId: 
      amount: 1
      text: 
  - optionText: "ไม่ใช่เรื่องของท่าน"
    responseText: "หึ ปากกล้านัก จงจำคำนี้ไว้ให้ดีเถิด"
    actions:
    - type: 4
      targetId: Sena
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
