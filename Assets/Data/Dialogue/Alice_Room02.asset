%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Alice_Room02
  m_EditorClassIdentifier:
  dialogueId: alice_room02
  speakerId: Alice
  speakerName: Alice
  speakerPortrait: {fileID: 21300000, guid: ab111111111111111111111111111111, type: 3}
  personalityPrompt:
  lines:
  - "หอสมุด... หนังสือเป็นพันเล่มเลยนะเนี่ย แล้วก็ไม่มีฝุ่นจับสักเล่ม เหมือนมีใครดูแลอยู่ตลอด"
  - "มีนางฟ้ายืนขวางประตูเรืองแสงอยู่ด้านบนนั่น... ท่าทางนางจะไม่ยอมให้เราผ่านไปง่ายๆ แน่"
  - "ไปคุยกับนางดูก่อนสิ อยากรู้ว่านางจะเรียกร้องอะไรจากเรา ...ถ้าติดตรงไหนก็มาถามฉันได้"
  overrideReturnLines: 1
  returnLines:
  - "...ว่าไง ติดตรงไหนหรือเปล่า"
  - "ถามมาได้นะ ฉันไม่ได้อยากค้างอยู่ในหอสมุดนี้ไปตลอดชีวิตหรอก"
  choices:
  - optionText: "เข้าใจแล้ว เราช่วยกันหาทางออกเถอะ"
    responseText: "อืม... ฉันจะคอยช่วยดูเบาะแสให้"
    actions:
    - type: 4
      targetId: Alice
      amount: 3
      text:
  - optionText: "นางฟ้านั่นดูหยิ่งจัง"
    responseText: "ใช่... พูดจาเหมือนคนอายุพันปีที่เบื่อมนุษย์เต็มที แต่ถ้าเราทำตามที่นางขอได้ นางก็คงต้องยอมเปิดทางให้"
    actions:
    - type: 4
      targetId: Alice
      amount: 2
      text:
  - optionText: "อย่ามาเกะกะแล้วกัน"
    responseText: "...งั้นเหรอ ถ้างั้นก็จัดการเองแล้วกันนะ"
    actions:
    - type: 4
      targetId: Alice
      amount: -5
      text:
