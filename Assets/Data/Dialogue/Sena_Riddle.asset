%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Sena_Riddle
  m_EditorClassIdentifier:
  dialogueId: sena_riddle
  speakerId: Sena
  speakerName: "เซนะ (Sena)"
  speakerPortrait: {fileID: 21300000, guid: 1d146046dd6d494f921da5feb73d96ba, type: 3}
  personalityPrompt:
  lines:
  - "...หืม? เจ้าถือสิ่งใดมาในมือนั่น"
  - "จารึกที่ยังเขียนมิจบ... เจ้าเสาะหาจนพบจริงๆ ด้วยฤๅ น่าประหลาดใจยิ่งนัก สำหรับมนุษย์ตัวจ้อยเช่นเจ้า"
  - "เอาเถิด ข้ารับของถวายนี้ไว้ จงฟังปริศนาของข้าให้ดี เพราะข้าจะเอ่ยเพียงครานี้ครานเดียว:"
  - "'ข้าวิ่งนำหน้าเจ้าอยู่เสมอ ทว่ามิเคยไปถึงแห่งหนใด เจ้าเฝ้ารอข้าไปทั้งชีวิต แต่ครานที่ข้ามาถึงเจ้าจริงๆ ชื่อของข้าก็เปลี่ยนไปเสียแล้ว... ข้าคือสิ่งใด?'\n(I am always running ahead of you, yet I never arrive. You spend your life anticipating me, but the moment I reach you, my name has already changed. What am I?)"
  - "จงพิมพ์คำตอบลงในช่องเบื้องล่างแล้วกดส่งมาเถิด ...ข้ารอดูเจ้าล้มเหลวอยู่"
  overrideReturnLines: 1
  returnLines:
  - "เจ้ายังมิได้คำตอบฤๅ? ข้าก็ว่าแล้ว"
  - "ข้าจะทวนปริศนาให้อีกครา:"
  - "'ข้าวิ่งนำหน้าเจ้าอยู่เสมอ ทว่ามิเคยไปถึงแห่งหนใด เจ้าเฝ้ารอข้าไปทั้งชีวิต แต่ครานที่ข้ามาถึงเจ้าจริงๆ ชื่อของข้าก็เปลี่ยนไปเสียแล้ว... ข้าคือสิ่งใด?'\n(I am always running ahead of you, yet I never arrive. You spend your life anticipating me, but the moment I reach you, my name has already changed. What am I?)"
  - "จงพิมพ์คำตอบลงในช่องเบื้องล่างเถิด"
  choices:
  - optionText: "ข้ากำลังขบคิดอยู่"
    responseText: "จงคิดเถิด ข้ามีเวลาทั้งนิรันดร์... แต่จงจำไว้ ทุกวินาทีที่เจ้าเสียไป คือวินาทีที่เจ้ามิมีวันเรียกคืน"
    actions: []
  - optionText: "ขอคำใบ้สักนิดเถอะ"
    responseText: "คำใบ้ฤๅ? ข้ามอบปริศนาให้แล้ว มิพอฤๅ! ผู้ที่ต้องพึ่งคำใบ้ มิสมควรผ่านประตูนี้ไปแต่แรกอยู่แล้ว"
    actions:
    - type: 4
      targetId: Sena
      amount: -5
      text:
  - optionText: "เจ้าคือใครกันแน่"
    responseText: "ข้าคือผู้ที่ยืนอยู่ตรงนี้ก่อนที่หอสมุดนี้จะถูกสร้าง และจะยังยืนอยู่เมื่อมันผุพังไปแล้ว... นั่นคือทั้งหมดที่เจ้าควรรู้"
    actions: []
