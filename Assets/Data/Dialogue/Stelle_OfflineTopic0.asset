MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Stelle_OfflineTopic0
  m_EditorClassIdentifier: 
  dialogueId: stelle_offline_0
  speakerId: Stelle
  speakerName: "สเตล (Stelle)"
  speakerPortrait: {fileID: 21300000, guid: c9c59aaa5dbe4114a1e627ffb5454328, type: 3}
  personalityPrompt: 
  lines:
  - "[:cry] คะ...คุณคะ คุณคิดถึงบ้านบ้างไหมคะ"
  - "สเตลคิดถึงห้องตัวเองมากเลยค่ะ ห้องที่ไฟสว่างๆ น่ะค่ะ"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "คิดถึงเหมือนกัน เดี๋ยวเราได้กลับบ้านแน่"
    responseText: "[:flustered] จะ...จริงนะคะ สเตลจะเชื่อคุณนะคะ"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Stelle
      secondaryId: 
      amount: 0
      text: "ผู้เล่นปลอบสเตลตอนที่เธอคิดถึงบ้าน"
  - optionText: "ห้องของสเตลเป็นแบบไหนเหรอ"
    responseText: "[:flustered] มีตุ๊กตาเต็มเลยค่ะ ...อ๊ะ อย่าหัวเราะนะคะ!"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: 1
      text: 
  - optionText: "ไว้ค่อยคุยกันนะ"
    responseText: "[:cry] คะ...ค่ะ ขอโทษที่กวนค่ะ"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
