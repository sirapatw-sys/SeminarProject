  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Stelle_Scare
  m_EditorClassIdentifier: 
  dialogueId: "stelle_scare"
  speakerId: "Stelle"
  speakerName: "สเตล (Stelle)"
  speakerPortrait: {fileID: 21300000, guid: c9c59aaa5dbe4114a1e627ffb5454328, type: 3}
  personalityPrompt: ""
  lines:
  - "[:shock] วะ...ว้ายยย! กระจก! ตัวหนังสือบนกระจกมันขึ้นมาเองค่ะ!"
  - "[:cry] ไม่เอาแล้ว... สเตลอยากกลับบ้าน..."
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ไม่เป็นไร ฉันอยู่ตรงนี้"
    responseText: "[:cry] ฮึก... ขะ...ขอบคุณค่ะ ขออยู่ใกล้ๆ นะคะ"
    actions:
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: 6
      text: ""
    - type: 10
      targetId: "Rina"
      secondaryId: "Stelle"
      amount: 2
      text: ""
    - type: 7
      targetId: "Stelle"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นปลอบตอนสเตลตกใจเรื่องข้อความบนกระจก"
  - optionText: "เงียบก่อน เดี๋ยวผีได้ยิน"
    responseText: "[:flustered] ...คะ-ค่ะ! (ปิดปากตัวเองแน่น)"
    actions:
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: -2
      text: ""
  - optionText: "ผีมันยืนอยู่ข้างหลังเธอน่ะ"
    responseText: "[:shock] ว้ายยยยย!! ...ไม่ตลกนะคะ! ไม่ตลกเลยสักนิด!"
    actions:
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: -6
      text: ""
    - type: 7
      targetId: "Stelle"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นแกล้งหลอกสเตลว่ามีผีอยู่ข้างหลัง"
  firstMeetingChoicesOnly: 0
