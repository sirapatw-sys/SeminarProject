  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Alice_Thirst
  m_EditorClassIdentifier: 
  dialogueId: alice_thirst
  speakerId: Alice
  speakerName: Alice
  speakerPortrait: {fileID: 21300000, guid: ab111111111111111111111111111111, type: 3}
  lines:
  - "ขอโทษนะ... จู่ ๆ ฉันก็รู้สึกคอแห้งขึ้นมา"
  - "ถ้าเธอไม่ลำบาก ช่วยหาน้ำให้ฉันหน่อยได้ไหม?"
  choices:
  - optionText: "ได้ เดี๋ยวฉันช่วยหาให้"
    responseText: "ขอบคุณนะ แค่เธอรับฟังก็ช่วยได้มากแล้ว"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: 3
      text: 
    - type: 8
      targetId: Alice
      secondaryId: thirst
      amount: -15
      text: 
    - type: 7
      targetId: Alice
      secondaryId: 
      amount: 0
      text: ผู้เล่นรับปากว่าจะช่วยหาน้ำให้
  - optionText: "พักก่อนนะ เดี๋ยวค่อยหาทางกัน"
    responseText: "อืม... อย่างน้อยได้นั่งพักก็น่าจะดีขึ้น"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: 1
      text: 
    - type: 8
      targetId: Alice
      secondaryId: thirst
      amount: -5
      text: 
  - optionText: "ตอนนี้ฉันไม่ว่าง"
    responseText: "เข้าใจแล้ว ฉันจะไม่รบกวนเธอ"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: -3
      text: 
    - type: 7
      targetId: Alice
      secondaryId: 
      amount: 0
      text: ผู้เล่นปฏิเสธตอนที่ Alice ขอน้ำ
