  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Room03_Quarrel
  m_EditorClassIdentifier: 
  dialogueId: "room03_quarrel"
  speakerId: "Rina"
  speakerName: "รินะ (Rina)"
  speakerPortrait: {fileID: 21300000, guid: 077f8282b9ce40a0b6b8fbec133e9c20, type: 3}
  personalityPrompt: ""
  lines:
  - "[Stelle:cry] ไม่เอาแล้วน้า! ห้ามไปยุ่งกับกล่องนั่นอีกนะคะ! ถ้าผีโกรธขึ้นมาจะทำยังไง!"
  - "ถ้าไม่ยุ่ง เราก็ติดอยู่ที่นี่ตลอดไปไง สเตล หยุดโวยวายก่อน"
  - "[Stelle:flustered] รินะก็พูดแบบนี้ทุกที! สเตลกลัวจริงๆ นะคะ ไม่ได้แกล้งทำ!"
  - "...นาย ช่วยบอกยัยนี่หน่อย ว่าเราควรทำยังไง"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ใจเย็นก่อน ขอฟังทั้งสองคนหน่อย"
    responseText: "...ก็ได้ ฉันแค่อยากออกไปจากที่นี่ ก่อนที่เราจะลืมว่าตัวเองเป็นใคร"
    actions:
    - type: 4
      targetId: "Rina"
      secondaryId: ""
      amount: 2
      text: ""
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: 2
      text: ""
    - type: 10
      targetId: "Rina"
      secondaryId: "Stelle"
      amount: 5
      text: ""
    - type: 0
      targetId: "room03_quarrel_listened"
      secondaryId: ""
      amount: 0
      text: ""
    - type: 7
      targetId: "Rina"
      secondaryId: ""
      amount: 0
      text: "ตอนทะเลาะกับสเตล ผู้เล่นขอฟังทั้งสองฝ่าย"
    - type: 7
      targetId: "Stelle"
      secondaryId: ""
      amount: 0
      text: "ตอนทะเลาะกับรินะ ผู้เล่นขอฟังทั้งสองฝ่าย"
  - optionText: "ทั้งคู่พูดถูก เราจะทำอย่างระวัง และจะไม่ทิ้งใครไว้"
    responseText: "[Stelle:blank] ...ถ้าคุณว่าอย่างนั้น สเตลก็... ลองดูก็ได้ค่ะ"
    actions:
    - type: 4
      targetId: "Rina"
      secondaryId: ""
      amount: 3
      text: ""
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: 4
      text: ""
    - type: 10
      targetId: "Rina"
      secondaryId: "Stelle"
      amount: 20
      text: ""
    - type: 0
      targetId: "room03_quarrel_mediated"
      secondaryId: ""
      amount: 0
      text: ""
    - type: 7
      targetId: "Rina"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นไกล่เกลี่ยตอนรินะทะเลาะกับสเตล"
    - type: 7
      targetId: "Stelle"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นไกล่เกลี่ยและสัญญาว่าจะไม่ทิ้งใครไว้"
  - optionText: "รินะพูดถูก เราต้องหาทางออก"
    responseText: "[Stelle:cry] ฮือ... ไม่มีใครเข้าใจสเตลเลย"
    actions:
    - type: 4
      targetId: "Rina"
      secondaryId: ""
      amount: 6
      text: ""
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: -8
      text: ""
    - type: 10
      targetId: "Rina"
      secondaryId: "Stelle"
      amount: -10
      text: ""
    - type: 0
      targetId: "room03_sided_rina"
      secondaryId: ""
      amount: 0
      text: ""
    - type: 7
      targetId: "Rina"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นเข้าข้างรินะตอนทะเลาะกับสเตล"
    - type: 7
      targetId: "Stelle"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นเข้าข้างรินะ ไม่ฟังความกลัวของสเตล"
  - optionText: "สเตลพูดถูก อย่าไปยุ่งกับของผีดีกว่า"
    responseText: "...ก็ตามใจ แต่ถ้าติดอยู่ที่นี่ไปตลอดชีวิต อย่ามาบ่นกับฉันล่ะ"
    actions:
    - type: 4
      targetId: "Rina"
      secondaryId: ""
      amount: -8
      text: ""
    - type: 4
      targetId: "Stelle"
      secondaryId: ""
      amount: 6
      text: ""
    - type: 10
      targetId: "Rina"
      secondaryId: "Stelle"
      amount: -10
      text: ""
    - type: 0
      targetId: "room03_sided_stelle"
      secondaryId: ""
      amount: 0
      text: ""
    - type: 7
      targetId: "Rina"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นเข้าข้างสเตลตอนทะเลาะ ไม่เห็นด้วยกับรินะ"
    - type: 7
      targetId: "Stelle"
      secondaryId: ""
      amount: 0
      text: "ผู้เล่นเข้าข้างสเตลตอนทะเลาะกับรินะ"
  firstMeetingChoicesOnly: 0
