  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Rina_OfflineTopic0
  m_EditorClassIdentifier: 
  dialogueId: rina_offline_0
  speakerId: Rina
  speakerName: "รินะ (Rina)"
  speakerPortrait: {fileID: 21300000, guid: 077f8282b9ce40a0b6b8fbec133e9c20, type: 3}
  personalityPrompt: 
  lines:
  - "นายมองวงแหวนบนหัวฉันอยู่ใช่ไหม"
  - "ไม่ต้องเกร็ง ฉันเองก็ไม่รู้ว่ามันมาจากไหน ถือซะว่าเป็นไฟฉายฟรีแล้วกัน"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "มันก็ดูเข้ากับเธอดีนะ"
    responseText: "ชมแปลกดี แต่ฉันรับไว้ก็แล้วกัน"
    actions:
    - type: 4
      targetId: Rina
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Rina
      secondaryId: 
      amount: 0
      text: "ผู้เล่นชมวงแหวนแสงบนหัวของรินะ"
  - optionText: "ไม่รู้สึกอะไรเลยเหรอ"
    responseText: "ตอนแรกก็รำคาญ ตอนนี้ชินแล้ว ห้องมืดขนาดนี้มีไฟติดตัวก็ไม่เลว"
    actions:
    - type: 4
      targetId: Rina
      secondaryId: 
      amount: 1
      text: 
  - optionText: "เรื่องนั้นไว้ทีหลังเถอะ"
    responseText: "อ้อ งั้นก็ตามสบาย"
    actions:
    - type: 4
      targetId: Rina
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
