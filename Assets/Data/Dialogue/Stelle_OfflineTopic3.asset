MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Stelle_OfflineTopic3
  m_EditorClassIdentifier: 
  dialogueId: stelle_offline_3
  speakerId: Stelle
  speakerName: "สเตล (Stelle)"
  speakerPortrait: {fileID: 21300000, guid: c9c59aaa5dbe4114a1e627ffb5454328, type: 3}
  personalityPrompt: 
  lines:
  - "[:flustered] คุณคะ... ถ้าสเตลกล้าขึ้นอีกนิด รินะจะชมสเตลบ้างไหมคะ"
  - "ฮือ...พูดออกมาแล้วเขินจังเลยค่ะ"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ชมแน่นอน สเตลกล้าขึ้นเยอะแล้วนะ"
    responseText: "[:flustered] จะ...จริงเหรอคะ! สะ...สเตลจะพยายามต่อนะคะ"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Stelle
      secondaryId: 
      amount: 0
      text: "ผู้เล่นบอกสเตลว่าเธอกล้าขึ้นเยอะแล้ว"
  - optionText: "ทำไมอยากให้รินะชมล่ะ"
    responseText: "[:flustered] ก็...รินะดูเก่งไปหมดเลยค่ะ สเตลอยากเป็นแบบนั้นบ้าง"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: 1
      text: 
  - optionText: "ไปถามรินะเองสิ"
    responseText: "[:shock] มะ...ไม่กล้าหรอกค่ะ! ...ช่างมันเถอะค่ะ"
    actions:
    - type: 4
      targetId: Stelle
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
