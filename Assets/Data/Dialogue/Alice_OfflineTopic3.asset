  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Alice_OfflineTopic3
  m_EditorClassIdentifier: 
  dialogueId: alice_offline_3
  speakerId: Alice
  speakerName: "Alice"
  speakerPortrait: {fileID: 21300000, guid: ab111111111111111111111111111111, type: 3}
  personalityPrompt: 
  lines:
  - "...เคยคิดไหมว่าทำไมต้องเป็นเรา"
  - "ไม่ได้รู้จักกันมาก่อนแท้ๆ แต่ดันมาติดอยู่ที่เดียวกัน"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "อาจจะเป็นโชคดีก็ได้ ที่ไม่ต้องติดอยู่คนเดียว"
    responseText: "...พูดอะไรเลี่ยนๆ ...แต่ก็ไม่ผิดหรอก"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Alice
      secondaryId: 
      amount: 0
      text: "ผู้เล่นบอก Alice ว่าดีแล้วที่ไม่ต้องติดอยู่ที่นี่คนเดียว"
  - optionText: "เธอคิดว่าเพราะอะไรล่ะ"
    responseText: "...ไม่รู้สิ ถ้ารู้ก็คงไม่ต้องถามเธอ"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: 1
      text: 
  - optionText: "คิดไปก็ไม่ได้อะไรหรอก"
    responseText: "...ก็จริง ช่างมันเถอะ"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
