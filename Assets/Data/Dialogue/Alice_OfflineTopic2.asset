  m_Script: {fileID: 11500000, guid: 3b75aa9e7779470c889557275485c8a2, type: 3}
  m_Name: Alice_OfflineTopic2
  m_EditorClassIdentifier: 
  dialogueId: alice_offline_2
  speakerId: Alice
  speakerName: "Alice"
  speakerPortrait: {fileID: 21300000, guid: ab111111111111111111111111111111, type: 3}
  personalityPrompt: 
  lines:
  - "...เธอเหนื่อยรึเปล่า เดินวนมาตั้งนานแล้ว"
  - "ฉันไม่ได้เป็นห่วงนะ แค่ไม่อยากต้องลากเธอออกไปทีหลัง"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "ขอบใจนะที่ถาม ฉันยังไหว"
    responseText: "...ก็ดี ไหวก็ไปต่อกัน"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Alice
      secondaryId: 
      amount: 0
      text: "Alice แอบถามว่าผู้เล่นเหนื่อยไหม และผู้เล่นขอบใจที่เธอถาม"
  - optionText: "แล้วเธอล่ะ เหนื่อยไหม"
    responseText: "...ฉันน่ะเหรอ ก็นิดหน่อย ไม่ต้องสนใจหรอก"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: 1
      text: 
  - optionText: "ไม่ต้องห่วงฉันหรอก"
    responseText: "...ใครห่วงกัน"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
