  dialogueId: alice_offline_1
  speakerId: Alice
  speakerName: "Alice"
  speakerPortrait: {fileID: 21300000, guid: ab111111111111111111111111111111, type: 3}
  personalityPrompt: 
  lines:
  - "...ที่นี่เงียบเกินไปนะ"
  - "ไม่ได้กลัวหรอก แค่... พูดอะไรสักอย่างก็ได้"
  overrideReturnLines: 0
  returnLines: []
  choices:
  - optionText: "งั้นฉันชวนคุยเองนะ"
    responseText: "...อืม ก็ดี เสียงเธอยังดีกว่าความเงียบ"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: 3
      text: 
    - type: 7
      targetId: Alice
      secondaryId: 
      amount: 0
      text: "ผู้เล่นยอมคุยเป็นเพื่อนตอนที่ Alice บอกว่าที่นี่เงียบเกินไป"
  - optionText: "เธอกลัวความเงียบเหรอ"
    responseText: "...บอกแล้วไงว่าไม่ได้กลัว"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: 1
      text: 
  - optionText: "ตอนนี้ขอเงียบๆ ก่อนนะ"
    responseText: "...ตามใจ"
    actions:
    - type: 4
      targetId: Alice
      secondaryId: 
      amount: -2
      text: 
  firstMeetingChoicesOnly: 0
