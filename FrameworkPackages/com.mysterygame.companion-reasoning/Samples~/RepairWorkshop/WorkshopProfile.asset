%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_Script: {fileID: 11500000, guid: 67e2af4cbdb94250ad954f791c100001, type: 3}
  m_Name: WorkshopProfile
  npcId: Mika
  insufficientEvidenceLine: "I cannot judge that yet."
  clarifyLine: "Which observation supports that idea?"
  rules:
  - id: cable
    phrases: ["maybe the cable is loose", "the cable is loose"]
    requiredFacts: [loose_cable, power_off]
    requiredFlags: []
    excludedFlags: [repaired]
    cautiousLine: "We have observations, but that does not mean the device is fixed."
    normalLine: "The loose cable and power being off support checking the connection."
    detailedLine: "Check the connection with the power off, then test it yourself."
    insufficientLine: "Inspect the cable and the power switch before we judge that."
